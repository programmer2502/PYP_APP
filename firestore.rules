rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isUserInRole(role) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isConversationParticipant(data) {
      return isAuthenticated() && (
        data.customerId == request.auth.uid ||
        data.photographerId == request.auth.uid ||
        (data.participants != null && request.auth.uid in data.participants)
      );
    }

    function isPaidBooking(bookingId) {
      return bookingId != null &&
        exists(/databases/$(database)/documents/bookings/$(bookingId)) &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.paymentStatus == 'paid' &&
        get(/databases/$(database)/documents/bookings/$(bookingId)).data.chatEnabled == true;
    }

    // ==========================================
    // USERS COLLECTION
    // ==========================================
    match /users/{userId} {
      // Users can read/write only their own document
      allow read, update, delete: if isOwner(userId);
      allow create: if isAuthenticated() && request.auth.uid == userId;
      
      // User Favorites subcollection
      match /favorites/{photographerId} {
        allow read, write: if isOwner(userId);
      }

      // User FCM Tokens subcollection
      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(userId);
      }

      // User Notifications subcollection
      match /notifications/{notificationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // ==========================================
    // PHOTOGRAPHERS COLLECTION
    // ==========================================
    match /photographers/{photographerId} {
      // Anyone can read public photographer profiles
      allow read: if true;
      
      // Photographers can only create/update their own profile
      allow create: if isAuthenticated() && request.auth.uid == photographerId;
      allow update, delete: if isOwner(photographerId);
    }

    // ==========================================
    // PORTFOLIOS COLLECTION
    // ==========================================
    match /portfolios/{portfolioId} {
      // Anyone can view portfolio items
      allow read: if true;
      
      // Photographers can only create/update/delete portfolio items belonging to them
      allow create: if isAuthenticated() && request.resource.data.photographerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.photographerId == request.auth.uid;
    }

    // ==========================================
    // BOOKINGS COLLECTION
    // ==========================================
    match /bookings/{bookingId} {
      // Customer and assigned photographer can read the booking
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.photographerId == request.auth.uid
      );
      
      // Customers can create bookings for themselves with pending/unpaid initial state
      allow create: if isAuthenticated() && 
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'Pending' &&
        request.resource.data.paymentStatus == 'unpaid' &&
        (request.resource.data.chatEnabled == false || request.resource.data.chatEnabled == null);
      
      // Status updates: strictly validated transitions.
      // paymentStatus, chatEnabled, and conversationId can NEVER be forged directly by client.
      allow update: if isAuthenticated() && (
        // Customer can only cancel their own pending booking
        (resource.data.customerId == request.auth.uid &&
         request.resource.data.status == 'Cancelled' &&
         resource.data.status == 'Pending' &&
         request.resource.data.paymentStatus == resource.data.paymentStatus &&
         request.resource.data.chatEnabled == resource.data.chatEnabled) ||
        
        // Photographer can accept, reject, or cancel their bookings
        (resource.data.photographerId == request.auth.uid && (
          (request.resource.data.status == 'Accepted' && resource.data.status == 'Pending') ||
          (request.resource.data.status == 'Rejected' && resource.data.status == 'Pending') ||
          (request.resource.data.status == 'Cancelled' && resource.data.status == 'Accepted') ||
          (request.resource.data.status == 'Completed' && resource.data.status == 'Accepted')
        ) &&
         request.resource.data.paymentStatus == resource.data.paymentStatus &&
         request.resource.data.chatEnabled == resource.data.chatEnabled)
      );
      
      allow delete: if false; // Bookings must not be arbitrarily deleted
    }

    // ==========================================
    // AVAILABILITY COLLECTION
    // ==========================================
    match /availability/{availabilityId} {
      // Anyone can read available slot times
      allow read: if true;
      
      // Photographers can manage only their own availability
      allow create: if isAuthenticated() && request.resource.data.photographerId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.photographerId == request.auth.uid;
    }

    // ==========================================
    // PAYMENTS COLLECTION (Admin / Backend Only)
    // ==========================================
    match /payments/{paymentId} {
      // Customers and photographers can only read payment receipts related to them
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.photographerId == request.auth.uid
      );
      // Client code cannot write directly to payments collection; handled via trusted Cloud Functions
      allow write: if false;
    }

    // ==========================================
    // CONVERSATIONS & CHAT (Payment-Gated Security)
    // ==========================================
    match /conversations/{conversationId} {
      // Reading/updating conversation requires participant status AND verified paid booking
      allow read: if isConversationParticipant(resource.data) &&
        (resource.data.bookingId == null || isPaidBooking(resource.data.bookingId));
        
      allow update: if isConversationParticipant(resource.data) &&
        (resource.data.bookingId == null || isPaidBooking(resource.data.bookingId));
      
      allow create: if isConversationParticipant(request.resource.data) &&
        (request.resource.data.bookingId == null || isPaidBooking(request.resource.data.bookingId));
      
      // Messages Subcollection: Strict enforcement of payment-gated chat
      match /messages/{messageId} {
        allow read: if isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.bookingId == null ||
           isPaidBooking(get(/databases/$(database)/documents/conversations/$(conversationId)).data.bookingId));
           
        allow create: if isAuthenticated() &&
          (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system') &&
          isConversationParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
          (get(/databases/$(database)/documents/conversations/$(conversationId)).data.bookingId == null ||
           isPaidBooking(get(/databases/$(database)/documents/conversations/$(conversationId)).data.bookingId));
           
        allow update, delete: if false;
      }
    }
  }
}
